POSTGRES_PASSWORD=
# токены исполнителей и интерфейса: имя:секрет через запятую. ui — страница /bft, видит все инициативы (BOX_ADMINS)
BOX_TOKENS=hermes:замените-секрет,ui:замените-секрет-ui
BOX_ADMINS=ui

# Модель — любой OpenAI-совместимый API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
# демо без ключа: docker compose --profile demo up -d, LLM_BASE_URL=http://llm-demo:8710/v1, LLM_API_KEY=demo

# Адрес Temporal UI для ссылок со страницы /bft; интерфейс слушает 127.0.0.1 (BOX_BIND=0.0.0.0 — наружу, только за прокси)
TEMPORAL_UI_URL=http://127.0.0.1:8233
BOX_BIND=127.0.0.1
