{
  "name": "poh-bft-plugin",
  "version": "0.1.0",
  "description": "Раздел «Управление требованиями» для DeepSeek Harness: очередь БФТ, документы и доска стадий поверх артефактов poh-bft-writer",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json && tsdown",
    "test": "tsc -p tsconfig.test.json && node --test lib-test/test/*.test.js",
    "test:e2e": "tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "playbook:shots": "PLAYBOOK_SHOTS_DIR=../docs/guides/plugin-playbooks/screenshots pnpm test:e2e"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-alpha.5",
    "@playwright/test": "1.59.1",
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.16.5"
  }
}
