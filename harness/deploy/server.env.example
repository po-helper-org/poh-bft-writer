# Настройки выкладки портала на сервер — для harness/deploy-server.sh.
# Скопируйте: cp harness/deploy/server.env.example harness/deploy/server.env
# и впишите свои значения. server.env в git не попадает (.gitignore).
# Формат — строки KEY=VALUE для bash (значения с пробелами — в кавычках).

# ssh-алиас или user@host сервера (из ~/.ssh/config).
DEPLOY_HOST=deploy-server
# Каталог портала на сервере, относительно домашнего каталога пользователя сервера
# (без ~ и «/» в начале).
# Держите отдельно от клона, который ведёт автодеплой main.
DEPLOY_DIR=Projects/poh-bft-portal

# Внешний адрес портала (nginx /bft/ за Authentik), без завершающего «/».
PORTAL_PUBLIC_URL=https://portal.example.org/bft
# Имена хоста портала для /api-fence dsh (через пробел). Первое имя —
# vhost nginx для harness/deploy/install-nginx-bft.sh.
PORTAL_TRUSTED_HOSTS=portal.example.org

# Источник данных po-hq: адрес MCP шлюза агентов (Jira/Confluence, только чтение).
# Пусто — источник не настроен.
DATA_SOURCES_URL_PO_HQ=https://agents.example.org/mcp
# Каталог шлюза агентов на сервере (для harness/deploy/issue-sources-token.sh),
# относительно домашнего каталога пользователя сервера (без ~ и «/» в начале).
AGENT_GATEWAY_DIR=Projects/agent-gateway

# Подсеть docker-сети портала — задать под свой сервер: свободная маленькая сеть,
# не пересекается с остальными сетями docker хоста.
PORTAL_SUBNET=172.31.244.0/27
