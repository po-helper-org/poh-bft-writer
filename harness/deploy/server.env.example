# Настройки выкладки портала на сервер — для harness/deploy-server.sh.
# Скопируйте: cp harness/deploy/server.env.example harness/deploy/server.env
# и впишите свои значения. server.env в git не попадает (.gitignore).
# Формат — строки KEY=VALUE для bash (значения с пробелами — в кавычках).

# ssh-алиас или user@host сервера (из ~/.ssh/config).
DEPLOY_HOST=deploy-server
# Каталог портала на сервере, относительно домашнего каталога пользователя сервера
# (без ~ и «/» в начале).
# Держите отдельно от клона, который ведёт автодеплой main.
DEPLOY_DIR=Projects/poh-bft-portal

# Внешний адрес портала (nginx /bft/ за Authentik), без завершающего «/».
PORTAL_PUBLIC_URL=https://portal.example.org/bft
# Имена хоста портала для /api-fence dsh (через пробел). Первое имя —
# vhost nginx для harness/deploy/install-nginx-bft.sh.
PORTAL_TRUSTED_HOSTS=portal.example.org

# Источник данных atlassian — шлюз источников (ADR-0015): ровно четыре
# инструмента чтения Jira и Confluence. Адрес — тот же хост, что у портала,
# путь /bft-sources/mcp (nginx → 127.0.0.1:3086). Пусто — источник не настроен.
# Токен сюда не пишется: его выпускает harness/deploy/install-sources-gateway.sh
# прямо на сервере.
DATA_SOURCES_URL_ATLASSIAN=https://portal.example.org/bft-sources/mcp
# Откуда install-sources-gateway.sh берёт адреса и токены Jira/Confluence для
# шлюза: конфиг MCP-клиента на сервере (путь относительно домашнего каталога,
# без ~ и «/» в начале) и имя сервера в нём (mcp_servers.<имя>).
SOURCES_MCP_CONFIG=.config/mcp/config.yaml
SOURCES_MCP_SERVER=atlassian

# Подсеть docker-сети портала — задать под свой сервер: свободная маленькая сеть,
# не пересекается с остальными сетями docker хоста.
PORTAL_SUBNET=172.31.244.0/27

# Память агента bft-creator (ADR-0016) — то, на что опирается /bft: системы, процессы,
# домены, люди, термины, прошлые БФТ. Ставит harness/deploy/install-bft-memory.sh на
# сервере. Пути — от домашнего каталога сервера, без ~ и «/» в начале; пустой —
# источник не используется. Без BFT_MEMORY_DIR Кортекс читает клон poh-cortex.
BFT_MEMORY_DIR=.local/share/bft-creator/memory
# Словарь JSON {термин: {meaning, deleted?}}.
BFT_MEMORY_GLOSSARY=
# IT-карта, markdown.
BFT_MEMORY_ITMAP=
# Итоговые БФТ прошлых заявок, markdown, через запятую без пробелов.
BFT_MEMORY_BFT=
# Каталог готовых узлов памяти (разбор прошлых БФТ в формате poh-cortex).
BFT_MEMORY_CURATED=.local/share/bft-creator/curated
# Обращение для живого E2E (harness/e2e-bft-live.sh) — текстовый файл на сервере, в
# домене, который знает память; пусто — нейтральное обращение.
BFT_E2E_REQUEST_FILE=.local/share/bft-creator/e2e-request.txt

# Форма вопросов по БФТ (ADR-0018): 1 — ссылка формы короткая и открытая
# (https://<хост>/bft/form?id=…). Ставить после разового шага владельца
# harness/deploy/install-nginx-bft.sh (location /bft/form без Authentik);
# до него ссылка — маршрут портала за входом.
BFT_FORM_PUBLIC=
# MCP «Система БФТ» (ADR-0023): 1 — адрес для агентов короткий, <портал>/mcp (nginx /bft/mcp без
# Authentik, доступ — личный токен). Включать после шага владельца install-nginx-bft.sh.
BFT_MCP_PUBLIC=

# ИИ-агент правок полного БФТ (ADR-0024). Локальные правки — быстрая модель dsh
# (пусто — выбор в «Настройках → Портал», по умолчанию Haiku через requesty).
PORTAL_LOCAL_PROVIDER=
PORTAL_LOCAL_MODEL=
# Полное ревью согласованности — внешний агент без инструментов через шлюз агентов.
# UPSTREAM — куда nginx ведёт точный location /bft-review/v1/responses (метод ответа
# одного агента на loopback хоста; ставит install-nginx-bft.sh); URL — тот же путь
# снаружи, по нему ходит портал. Пусто — полное ревью делает модель полного БФТ.
# Ключ агента сюда не пишется: владелец кладёт его на сервере
# (harness/deploy/set-review-agent-key.sh).
BFT_REVIEW_AGENT_UPSTREAM=
BFT_REVIEW_AGENT_URL=
BFT_REVIEW_AGENT_MODEL=
