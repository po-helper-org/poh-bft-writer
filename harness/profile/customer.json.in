{
  "name": "dsh-profile-customer",
  "private": true,
  "dependencies": {
    "@deepseek-ai/dsh": "__DSH_VERSION__",
    "@deepseek-ai/dsh-base": "__DSH_VERSION__",
    "@deepseek-ai/dsh-web-app": "__DSH_VERSION__",
    "@deepseek-ai/dsh-llm-pi-ai": "__DSH_VERSION__",
    "@temporalio/client": "1.25.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "customer-form": "file:customer-form",
    "speech-ru": "file:speech-ru",
    "bft-manager": "file:bft-manager",
    "data-sources": "file:data-sources",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "__DSH_VERSION__"
  },
  "dsh": {
    "profile": {
      "bundles": ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-llm-pi-ai", "@deepseek-ai/dsh-web-app", "@deepseek-ai/dsh-experimental-voice-input-bundle", "speech-ru", "customer-form", "bft-manager", "data-sources"],
      "patchReload": "live"
    }
  }
}
