# poh-bft-writer · harness/.env — секреты и режимы автономной системы.
# Скопируйте: cp .env.example .env — остальное допишет ./start.sh (секреты)
# и онбординг UI (ключ ZAI). Ничего из этого в git не попадает.

# ── LLM-провайдер Z.AI (GLM) ───────────────────────────────────────────────────
# Единый ключ для харнесса (fast/агенты) и коробки (deep-итерации).
# Пусто на старте → UI предложит онбординг (US-5–8).
ZAI_API_KEY=
# Модель deep-итераций коробки (fast-скоринг харнесса использует glm-5-turbo
# из каталога роута zai — задаётся в профиле, не здесь).
LLM_MODEL=glm-4.7

# ── Генерирует ./start.sh при первом запуске (руками не заполнять) ────────────
# POSTGRES_PASSWORD=...
# BOX_TOKENS=ui:...,agent:...

# ── Опционально ────────────────────────────────────────────────────────────────
# PUBLIC_URL=http://127.0.0.1:3080   # форма ссылки с токеном (за прокси — своя)
# HARNESS_BIND=127.0.0.1             # на чём слушать порт 3080 хоста
# BOX_BIND=127.0.0.1                 # на чём слушать debug-порт temporal-ui

# ── Демо без ключа: docker compose --profile demo up -d ───────────────────────
# LLM_BASE_URL в этом режиме start.sh подставит сам на llm-demo:8710/v1.
