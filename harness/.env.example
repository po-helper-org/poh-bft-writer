# poh-bft-writer · harness/.env — секреты и режимы автономной системы.
# Скопируйте: cp .env.example .env — остальное допишет ./start.sh (секреты)
# и онбординг UI (ключ ZAI). Ничего из этого в git не попадает.

# ── LLM-провайдер Z.AI (GLM) ───────────────────────────────────────────────────
# Единый ключ для харнесса (fast/агенты) и коробки (deep-итерации).
# Пусто на старте → UI предложит онбординг (US-5–8).
ZAI_API_KEY=
# Ключ Anthropic API — портал заказчика на Claude Haiku 5.5 (./set-key.sh --anthropic).
# Задан → важнее остальных ключей портала.
ANTHROPIC_API_KEY=
# Ключ подписки Z.AI GLM Coding Plan — портал заказчика на GLM-5
# (./set-key.sh --coding). Пусто → портал на Requesty или zai/glm-5-turbo.
ZAI_CODING_API_KEY=
# Необязательно (ADR-0017): ключ Google Drive API — список папок Drive по ссылке
# заказчика через API. Без ключа открытые по ссылке Docs/Slides/Sheets/папки читаются экспортом Google.
GOOGLE_DRIVE_API_KEY=
# Модель deep-итераций коробки (fast-скоринг харнесса использует glm-5-turbo
# из каталога роута zai — задаётся в профиле, не здесь).
LLM_MODEL=glm-4.7

# ── Генерирует ./start.sh при первом запуске (руками не заполнять) ────────────
# ADMIN_PASSWORD=...   # вход администратора портала: /api/customer-form.admin
# POSTGRES_PASSWORD=...
# BOX_TOKENS=ui:...,agent:...

# ── Опционально ────────────────────────────────────────────────────────────────
# PUBLIC_URL=http://127.0.0.1:3080   # форма ссылки с токеном (за прокси — своя)
# HARNESS_BIND=127.0.0.1             # на чём слушать порт 3080 хоста
# BOX_BIND=127.0.0.1                 # на чём слушать debug-порт temporal-ui
# Источник данных atlassian — шлюз источников (ADR-0015): MCP ровно с четырьмя
# инструментами чтения Jira и Confluence. Адрес (например
# https://portal.example.org/bft-sources/mcp) и его bearer-токен; нет одного из
# них → источник не настроен. На сервере токен пишет
# harness/deploy/install-sources-gateway.sh (без вывода значения).
# DATA_SOURCES_URL_ATLASSIAN=
# DATA_SOURCES_TOKEN_ATLASSIAN=
# Для install-sources-gateway.sh (сервер): конфиг MCP-клиента с Jira/Confluence
# (путь от домашнего каталога) и имя сервера в нём. Переносит deploy-server.sh.
# SOURCES_MCP_CONFIG=.config/mcp/config.yaml
# SOURCES_MCP_SERVER=atlassian

# ── Демо без ключа: docker compose --profile demo up -d ───────────────────────
# LLM_BASE_URL в этом режиме start.sh подставит сам на llm-demo:8710/v1.
